import time
import sys
import os

logo = [
"███████╗██╗██████╗ ██████╗ ",
"██╔════╝██║██╔══██╗██╔══██╗",
"███████╗██║██████╔╝██████╔╝",
"╚════██║██║██╔══██╗██╔═══╝ ",
"███████║██║██║  ██║██║    ",
"╚══════╝╚═╝╚═╝  ╚═╝╚═╝     "
]

def animar():
    def limpar():
        os.system("cls" if os.name == "nt" else "clear")

    # digitação
    limpar()
    for linha in logo:
        for char in linha:
            print(char, end="")
            sys.stdout.flush()
            time.sleep(0.05)
        print()

    # piscar 2x
    for _ in range(2):
        time.sleep(0.2)
        limpar()
        time.sleep(0.2)
        for linha in logo:
            print(linha)

if __name__ == "__main__":
    animar()